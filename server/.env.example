# MongoDB connection string (MongoDB Atlas free tier works)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/trivia

# Public URL of the frontend, used to build the join link / QR code.
# Optional: if empty, the Origin of the request is used.
FRONTEND_URL=http://localhost:5173

# Allowed frontend origins for CORS (comma-separated). Leave empty to allow all.
CORS_ORIGIN=

PORT=3000
